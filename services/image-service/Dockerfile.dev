# ============================================================================
# FILE: services/image-service/Dockerfile.dev
# PURPOSE: Development image with full dependencies
# COMMIT: feat: add development Dockerfile with debugging tools
# ============================================================================

FROM python:3.11-slim

# ============================================================================
# INSTALL SYSTEM DEPENDENCIES (Full Dev Setup)
# ============================================================================

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    pkg-config \
    cmake \
    # Core libvips
    libvips-dev \
    libvips-tools \
    # AVIF support (Critical!)
    libaom-dev \
    libaom3 \
    # HEIF/HEIC support
    libheif-dev \
    libheif1 \
    libde265-dev \
    libx265-dev \
    # WebP support
    libwebp-dev \
    libwebpmux3 \
    libwebpdemux2 \
    # JPEG support
    libjpeg62-turbo-dev \
    # PNG support
    libpng-dev \
    # TIFF support
    libtiff-dev \
    # GIF support
    libgif-dev \
    # SVG support
    librsvg2-dev \
    # Pillow dependencies
    libfreetype6-dev \
    libfribidi-dev \
    libharfbuzz-dev \
    libjpeg-dev \
    liblcms2-dev \
    libopenjp2-7-dev \
    libtiff5-dev \
    libwebp-dev \
    tcl8.6-dev \
    tk8.6-dev \
    zlib1g-dev \
    # Utilities
    curl \
    vim \
    htop \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# SETUP APPLICATION
# ============================================================================

WORKDIR /app

# Install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# ============================================================================
# EXPOSE PORT
# ============================================================================

EXPOSE 8000

# ============================================================================
# DEV COMMAND (with reload)
# ============================================================================

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "debug"]