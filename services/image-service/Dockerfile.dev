# ============================================================================
# FILE: services/image-service/Dockerfile.dev
# PURPOSE: Development image with full tools
# ============================================================================

FROM python:3.11-slim

# ============================================================
# Install dependencies needed to build libvips WITH HEIF/AVIF
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    curl \
    libc6-dev \
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    libtiff-dev \
    libgif-dev \
    libglib2.0-dev \
    libexpat1-dev \
    libxml2-dev \
    libde265-dev \
    libx265-dev \
    libaom-dev \
    libheif-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Build libvips from source (FULL HEIF/AVIF support)
# ============================================================
ENV VIPS_VERSION=8.15.2

RUN curl -LO https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.gz \
    && tar xf vips-${VIPS_VERSION}.tar.gz \
    && cd vips-${VIPS_VERSION} \
    && meson setup build --prefix=/usr \
    && ninja -C build \
    && ninja -C build install \
    && ldconfig

# ============================================================
# Python setup
# ============================================================
WORKDIR /app
COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
