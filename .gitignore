.DS_Store
Thumbs.db

# -----------------------------
# ENV FILES (ROOT + SERVICES)
# -----------------------------
.env
.env.*
*.env
*/.env
*/.env.*
!.env.example

# -----------------------------
# NODE MODULES (ALL WORKSPACES)
# -----------------------------
node_modules/
**/node_modules/

# pnpm store (local only)
.pnpm-store/

# -----------------------------
# BUILD OUTPUTS
# -----------------------------
dist/
build/
out/
.next/
.next/*
.next/cache/
**/dist/
**/build/

# Turborepo cache
.turbo/

# Bun
.bun/

# -----------------------------
# LOG FILES
# -----------------------------
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
debug.log
logs/
**/logs/

# -----------------------------
# EDITOR / OS CACHE
# -----------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# -----------------------------
# DOCKER STUFF
# -----------------------------
docker-data/
docker-volume/
**/docker-data/
**/docker-volume/
*.pid

# Ignore Docker build context junk
**/.dockerignore
**/Dockerfile.local

# -----------------------------
# PYTHON (WORKERS)
# -----------------------------
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/

# venv
venv/
**/venv/
.env.python/

# -----------------------------
# TEMP / CACHE
# -----------------------------
temp/
tmp/
.cache/
**/.cache/
coverage/
coverage-final.json

# -----------------------------
# OUTPUT / ARTIFACTS
# -----------------------------
*.tar
*.tgz
*.zip

# -----------------------------
# LINTER / TS CACHE
# -----------------------------
.eslintcache
tsconfig.tsbuildinfo
**/*.tsbuildinfo

# -----------------------------
# FRONTEND STATIC GEN
# -----------------------------
public/build/
public/static/
